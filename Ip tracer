    }[data-theme="light"] {
  --bg-color: #ffffff;
  --text-color: #000000;
  --card-color: #f0f0f0;
  --input-bg: #e0e0e0;
  --button-bg: #007bff;
  --button-hover: #0056b3;
}

body {
  background-color: var(--bg-color);
  color: var(--text-color);
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  min-height: 100vh;
  margin: 0;
  padding-bottom: 50px;
  transition: background 0.3s, color 0.3s;
}

.container {
  background: var(--card-color);
  padding: 30px;
  border-radius: 15px;
  box-shadow: 0 0 15px #58a6ff;
  width: 80%;
  max-width: 500px;
  text-align: center;
  position: relative;
}

input, button {
  padding: 10px;
  margin: 10px 0;
  width: 80%;
  border: none;
  border-radius: 8px;
}

input {
  background: var(--input-bg);
  color: var(--text-color);
}

button {
  background: var(--button-bg);
  color: white;
  cursor: pointer;
}

button:hover {
  background: var(--button-hover);
}

#result, #history, #userDashboard {
  margin-top: 20px;
  background: var(--input-bg);
  padding: 15px;
  border-radius: 10px;
  text-align: left;
}

#map {
  margin-top: 15px;
  width: 100%;
  height: 300px;
  border-radius: 10px;
}

#themeToggle {
  position: absolute;
  top: 20px;
  right: 60px;
  font-size: 24px;
  cursor: pointer;
}

.menuToggle {
  position: absolute;
  top: 20px;
  right: 20px;
  font-size: 24px;
  cursor: pointer;
  z-index: 2;
}

.menuContent {
  display: none;
  position: absolute;
  top: 60px;
  right: 20px;
  background: var(--card-color);
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 0 10px #000;
  width: 300px;
  z-index: 3;
  opacity: 0;
  transform: translateY(-20px);
  transition: all 0.3s ease;
}

.menuContent.active {
  display: block;
  opacity: 1;
  transform: translateY(0);
}

footer {
  margin-top: 40px;
  text-align: center;
  font-size: 14px;
  color: var(--text-color);
}

a.learn-link {
  color: #58a6ff;
  text-decoration: underline;
  display: block;
  margin-top: 10px;
}

.user-info {
  margin-bottom: 10px;
  font-size: 14px;
  color: var(--text-color);
}

  </style>
</head>
<body>
  <div class="menuToggle" onclick="toggleMenu()">☰</div>
  <div id="themeToggle">🌙</div>
  <div class="menuContent" id="menuContent">
    <div class="user-info" id="userInfo"></div>
    <div class="auth" id="loginForm">
      <h3>Login</h3>
      <input type="email" id="loginEmail" placeholder="Email">
      <input type="password" id="loginPassword" placeholder="Password">
      <button onclick="loginUser()">Login</button>
      <button onclick="resetPassword()">Reset Password</button>
      <button onclick="loginWithGoogle()">Sign in with Google</button>
    </div>
    <div class="signup" id="signupForm">
      <h3>Sign Up</h3>
      <input type="email" id="signupEmail" placeholder="Email">
      <input type="password" id="signupPassword" placeholder="Password">
      <div class="g-recaptcha" data-sitekey="6LcsGIMrAAAAAPSJoChm7Ibzoo-7WZla7ve_IUj1"></div>
      <button onclick="signUpUser()">Create Account</button>
    </div>
    <button onclick="logoutUser()" id="logoutBtn" style="display:none; margin-top:10px;">Logout</button>
